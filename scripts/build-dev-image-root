#!/usr/bin/env bash

set -euo pipefail

[[ "${EUID:-$(id -u)}" -eq 0 ]] || {
    printf 'this helper must run as root\n' >&2
    exit 1
}

project_root="$(readlink -m -- "${SABLE_PROJECT_ROOT:?}")"
build_root="$(readlink -m -- "${SABLE_BUILD_ROOT:?}")"
image="$(readlink -m -- "${SABLE_IMAGE:?}")"
wallpaper="$(readlink -m -- "${SABLE_WALLPAPER:?}")"
owner_uid="${SABLE_OWNER_UID:?}"
owner_gid="${SABLE_OWNER_GID:?}"

[[ -f "$build_root/.sable-build-volume" && "$image" == "$build_root/"* ]] || {
    printf 'refusing image outside the marked Sable build volume\n' >&2
    exit 1
}
[[ ! -b "$image" && -f "$wallpaper" ]] || {
    printf 'invalid image or wallpaper path\n' >&2
    exit 1
}
[[ -x "$project_root/target/release/sable-desktopd" ]] || {
    printf 'missing release desktop service binary\n' >&2
    exit 1
}

for command_name in arch-chroot blkid btrfs findmnt gpgconf losetup mkfs.btrfs \
    mkfs.fat pacman-key pacstrap parted rsync udevadm; do
    command -v "$command_name" >/dev/null 2>&1 || {
        printf 'required command is missing: %s\n' "$command_name" >&2
        exit 1
    }
done

mount_root="$build_root/tmp/dev-image-root"
package_cache="$build_root/cache/pacman/pkg"
package_cache_mount="$mount_root/var/cache/pacman/pkg"
loop_device=""

cleanup() {
    set +e
    if [[ -d "$mount_root/etc/pacman.d/gnupg" ]]; then
        gpgconf --homedir "$mount_root/etc/pacman.d/gnupg" --kill all
    fi
    if mountpoint -q "$package_cache_mount"; then
        umount "$package_cache_mount"
    fi
    if mountpoint -q "$mount_root/boot/efi"; then
        umount "$mount_root/boot/efi"
    fi
    if mountpoint -q "$mount_root"; then
        umount -R "$mount_root" || umount -l "$mount_root"
    fi
    if [[ -n "$loop_device" ]]; then
        udevadm settle
        losetup -d "$loop_device" || {
            sleep 1
            losetup -d "$loop_device"
        }
        for _ in {1..20}; do
            losetup "$loop_device" >/dev/null 2>&1 || break
            sleep 0.25
        done
    fi
    rm -rf -- "$mount_root"
}
trap cleanup EXIT

if [[ -e "$image" ]]; then
    [[ -f "$image" ]] || {
        printf 'existing image is not a regular file: %s\n' "$image" >&2
        exit 1
    }
    rm -f -- "$image"
fi

mkdir -p -- "$(dirname -- "$image")" "$mount_root"
truncate -s 20G "$image"
parted -s "$image" mklabel gpt
parted -s "$image" mkpart ESP fat32 1MiB 1025MiB
parted -s "$image" set 1 esp on
parted -s "$image" mkpart SABLE btrfs 1025MiB 100%

loop_device="$(losetup --find --show --partscan "$image")"
udevadm settle
efi_partition="${loop_device}p1"
root_partition="${loop_device}p2"
[[ -b "$efi_partition" && -b "$root_partition" ]] || {
    printf 'loop partitions were not created\n' >&2
    exit 1
}

mkfs.fat -F 32 -n SABLE_EFI "$efi_partition"
mkfs.btrfs -f -K -L SABLE_ROOT "$root_partition"
mount -o compress=zstd,nodiscard "$root_partition" "$mount_root"
mkdir -p -- "$mount_root/boot/efi"
mount "$efi_partition" "$mount_root/boot/efi"
install -d "$package_cache" "$package_cache_mount"
mount --bind "$package_cache" "$package_cache_mount"

packages=(
    base
    linux-lts
    linux-firmware
    amd-ucode
    intel-ucode
    btrfs-progs
    cachyos-keyring
    cachyos-calamares
    dosfstools
    limine
    networkmanager
    pipewire
    pipewire-alsa
    pipewire-pulse
    wireplumber
    bluez
    bluez-utils
    sudo
    greetd
    greetd-regreet
    hyprland
    hyprpaper
    quickshell
    kitty
    thunar
    mesa
    vulkan-radeon
    vulkan-intel
    vulkan-icd-loader
    # hardware video acceleration (AMD VA-API ships in mesa; Intel needs its own driver)
    intel-media-driver
    libva-utils
    # audio + storage firmware/tools
    sof-firmware
    alsa-firmware
    alsa-ucm-conf
    nvme-cli
    xdg-desktop-portal
    xdg-desktop-portal-hyprland
    xorg-xwayland
    polkit-kde-agent
    firefox
    hyprlock
    pavucontrol
    wdisplays
    grim
    slurp
    wl-clipboard
    mako
    gvfs
    tumbler
    thunar-archive-plugin
    file-roller
    btop
    xdg-utils
    qt6-wayland
    xdg-desktop-portal-gtk
    noto-fonts
    noto-fonts-emoji
    ttf-dejavu
    ttf-liberation
    xdg-user-dirs
    bash-completion
    man-db
    man-pages
    openssh
    nano
    curl
    git
    jq
    # security-core tooling (baked in durably; see docs/SECURITY.md)
    nmap
    tcpdump
    wireshark-cli
    mtr
    whois
    openbsd-netcat
    socat
    traceroute
    bind
    ripgrep
    nftables
    wget
    iproute2
    inetutils
)

install -d -m0700 "$mount_root/etc/pacman.d/gnupg"
pacman-key --gpgdir "$mount_root/etc/pacman.d/gnupg" --init
pacman-key --gpgdir "$mount_root/etc/pacman.d/gnupg" \
    --populate archlinux cachyos

pacstrap -C "$project_root/dev-image/pacman.conf" "$mount_root" \
    "${packages[@]}"

root_uuid="$(blkid -s UUID -o value "$root_partition")"
efi_uuid="$(blkid -s UUID -o value "$efi_partition")"
cat >"$mount_root/etc/fstab" <<EOF
UUID=$root_uuid / btrfs rw,relatime,compress=zstd,nodiscard 0 0
UUID=$efi_uuid /boot/efi vfat rw,relatime,fmask=0077,dmask=0077 0 2
EOF

rsync -aHAX --chown=root:root \
    "$project_root/dev-image/rootfs/etc/" "$mount_root/etc/"
rsync -aHAX --chown=root:root \
    "$project_root/dev-image/rootfs/usr/" "$mount_root/usr/"
install -Dm0755 "$project_root/target/release/sable-desktopd" \
    "$mount_root/usr/lib/sable/sable-desktopd"
install -Dm0644 "$project_root/desktop/shell/shell.qml" \
    "$mount_root/usr/share/sable/shell/shell.qml"
install -Dm0644 "$project_root/desktop/settings/Main.qml" \
    "$mount_root/usr/share/sable/settings/Main.qml"
install -Dm0644 "$wallpaper" \
    "$mount_root/usr/share/backgrounds/sable/wallpaper.png"
install -Dm0755 "$project_root/installer/installer-preflight" \
    "$mount_root/usr/lib/sable/installer-preflight"
install -Dm0755 "$project_root/installer/finalize-install" \
    "$mount_root/usr/lib/sable/finalize-install"
install -Dm0755 "$project_root/installer/install-limine" \
    "$mount_root/usr/lib/sable/install-limine"
install -Dm0755 "$project_root/installer/launch-installer" \
    "$mount_root/usr/local/bin/sable-installer"
install -Dm0644 "$project_root/installer/calamares/settings.conf" \
    "$mount_root/etc/calamares/settings.conf"
rsync -aHAX --chown=root:root \
    "$project_root/installer/calamares/modules/" \
    "$mount_root/etc/calamares/modules/"
rsync -aHAX --chown=root:root \
    "$project_root/installer/calamares/branding/" \
    "$mount_root/usr/share/calamares/branding/"
touch "$mount_root/etc/sable-installer-preview"

arch-chroot "$mount_root" useradd -m \
    -G wheel,video,render,seat,audio,input,uucp -s /bin/bash sable
rsync -aHAX --chown=1000:1000 \
    "$project_root/dev-image/rootfs/home/sable/" "$mount_root/home/sable/"
rsync -aHAX --chown=root:root \
    "$project_root/dev-image/rootfs/home/sable/" "$mount_root/etc/skel/"
install -d -o 1000 -g 1000 "$mount_root/home/sable/.local/state/sable"
printf 'sable:sable\n' | arch-chroot "$mount_root" chpasswd
arch-chroot "$mount_root" systemctl enable NetworkManager.service
arch-chroot "$mount_root" systemctl enable systemd-resolved.service
# NetworkManager feeds DHCP DNS to systemd-resolved; point libc name resolution
# at the resolved stub so DNS (web, downloads, pacman) actually works.
ln -sf /run/systemd/resolve/stub-resolv.conf "$mount_root/etc/resolv.conf"
arch-chroot "$mount_root" systemctl enable bluetooth.service
arch-chroot "$mount_root" systemctl enable getty@tty1.service
arch-chroot "$mount_root" systemctl set-default graphical.target
install -d "$mount_root/etc/systemd/user/graphical-session.target.wants"
ln -sfn /etc/systemd/user/sable-desktopd.service \
    "$mount_root/etc/systemd/user/graphical-session.target.wants/sable-desktopd.service"

printf 'en_GB.UTF-8 UTF-8\n' >"$mount_root/etc/locale.gen"
arch-chroot "$mount_root" locale-gen
printf 'LANG=en_GB.UTF-8\n' >"$mount_root/etc/locale.conf"
printf 'KEYMAP=uk\n' >"$mount_root/etc/vconsole.conf"

install -d "$mount_root/boot/efi/EFI/BOOT" "$mount_root/boot/efi/EFI/sable"
install -m0644 /usr/share/limine/BOOTX64.EFI \
    "$mount_root/boot/efi/EFI/BOOT/BOOTX64.EFI"
install -m0644 "$mount_root/boot/vmlinuz-linux-lts" \
    "$mount_root/boot/efi/EFI/sable/vmlinuz-linux-lts"
install -m0644 "$mount_root/boot/initramfs-linux-lts.img" \
    "$mount_root/boot/efi/EFI/sable/initramfs-linux-lts.img"
install -m0644 "$wallpaper" \
    "$mount_root/boot/efi/EFI/sable/wallpaper.png"
sed "s/@ROOT_UUID@/$root_uuid/g" "$project_root/dev-image/limine.conf" \
    >"$mount_root/boot/efi/limine.conf"

printf 'Sable bootstrap image created successfully.\n'
printf 'Image: %s\nRoot UUID: %s\n' "$image" "$root_uuid"
sync
chown "$owner_uid:$owner_gid" "$image"
