[Unit]
Description=os_name desktop state service
PartOf=graphical-session.target
After=dbus.service

[Service]
Type=simple
ExecStart=/usr/lib/os_name/os-name-desktopd
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/os_name

[Install]
WantedBy=graphical-session.target
