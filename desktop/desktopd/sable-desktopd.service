[Unit]
Description=Sable desktop state service
PartOf=graphical-session.target
After=dbus.service

[Service]
Type=simple
ExecStart=/usr/lib/sable/sable-desktopd
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/sable

[Install]
WantedBy=graphical-session.target
