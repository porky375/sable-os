timeout: 2
default_entry: 1
interface_branding: Sable
interface_branding_color: f4f4f5
interface_help_hidden: yes
term_background: c0101010
term_foreground: f4f4f5
term_palette: 0b0b0b;3f3f46;52525b;71717a;a1a1aa;d4d4d8;e4e4e7;f4f4f5
term_palette_bright: 18181b;52525b;71717a;a1a1aa;cbd5e1;e4e4e7;f8fafc;ffffff
term_margin: 56
term_margin_gradient: 16

/Sable
    protocol: linux
    path: boot():/EFI/sable/vmlinuz-linux-lts
    module_path: boot():/EFI/sable/initramfs-linux-lts.img
    cmdline: root=UUID=@ROOT_UUID@ rootflags=subvol=@ rw quiet

/+Advanced options
//Sable current kernel
    protocol: linux
    path: boot():/EFI/sable/vmlinuz-linux
    module_path: boot():/EFI/sable/initramfs-linux.img
    cmdline: root=UUID=@ROOT_UUID@ rootflags=subvol=@ rw

@RECOVERY_ENTRIES@

@WINDOWS_ENTRY@
