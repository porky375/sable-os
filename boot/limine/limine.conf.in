timeout: 2
default_entry: 1
interface_branding: os_name
interface_branding_color: 7
interface_help_hidden: yes
term_background: 00101010
term_foreground: f4f4f5
term_palette: 101010;ef4444;22c55e;eab308;3b82f6;a855f7;06b6d4;d4d4d8
term_palette_bright: 27272a;f87171;4ade80;facc15;60a5fa;c084fc;22d3ee;ffffff

/os_name
    protocol: linux
    path: boot():/EFI/os_name/vmlinuz-linux-lts
    module_path: boot():/EFI/os_name/initramfs-linux-lts.img
    cmdline: root=UUID=@ROOT_UUID@ rootflags=subvol=@ rw quiet

/+Advanced options
//os_name current kernel
    protocol: linux
    path: boot():/EFI/os_name/vmlinuz-linux
    module_path: boot():/EFI/os_name/initramfs-linux.img
    cmdline: root=UUID=@ROOT_UUID@ rootflags=subvol=@ rw

@RECOVERY_ENTRIES@

@WINDOWS_ENTRY@
