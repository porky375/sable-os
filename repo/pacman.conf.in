[options]
Architecture = auto
CheckSpace
Color
ParallelDownloads = 5
SigLevel = Required DatabaseOptional TrustedOnly
LocalFileSigLevel = Required

[sable-core]
SigLevel = Required TrustedOnly
Server = @SABLE_REPO_BASE_URL@/@CHANNEL@/sable-core/$arch

[sable-desktop]
SigLevel = Required TrustedOnly
Server = @SABLE_REPO_BASE_URL@/@CHANNEL@/sable-desktop/$arch

[sable-extra]
SigLevel = Required TrustedOnly
Server = @SABLE_REPO_BASE_URL@/@CHANNEL@/sable-extra/$arch
