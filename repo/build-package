#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
# shellcheck source=scripts/lib/common.sh
source "$project_root/scripts/lib/common.sh"
load_project_env

require_command makechrootpkg
require_command mkarchroot
require_command repo-add

recipe="${1:-}"
[[ -n "$recipe" ]] || {
    printf 'usage: %s packages/recipe-directory\n' "$0" >&2
    exit 2
}
recipe="$(readlink -m -- "$recipe")"
[[ "$recipe" == "$project_root/packages/"* && -f "$recipe/PKGBUILD" ]] || {
    printf 'recipe must be a package directory under %s/packages\n' "$project_root" >&2
    exit 1
}

build_root="$(require_build_root)"
chroot="$build_root/chroots/os_name-$OS_ARCH"
package_output="$build_root/packages"
mkdir -p -- "$chroot" "$package_output"

if [[ ! -f "$chroot/root/.os-name-build-root" ]]; then
    printf 'The independent build root is not initialized yet.\n' >&2
    printf 'Stage-0 bootstrap must create %s/root/.os-name-build-root.\n' "$chroot" >&2
    exit 1
fi

(
    cd "$recipe"
    PKGDEST="$package_output" makechrootpkg -r "$chroot" -c
)
